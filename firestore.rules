rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is an admin (owner or in admin/config.adminEmails)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'agewaller@gmail.com' ||
        (
          exists(/databases/$(database)/documents/admin/config) &&
          request.auth.token.email in
            get(/databases/$(database)/documents/admin/config).data.adminEmails
        )
      );
    }

    // Per-user data: owner has full read/write; admin has read-only for management
    match /users/{userId} {
      // Owner can read and write everything in their doc.
      // Admin can read any user's doc for the user management tab.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      // Admins can list users for user management
      allow list: if isAdmin();

      match /{subcollection}/{docId} {
        // Owner has full access to their subcollections (records, history, etc.)
        // Admin can only read, not write.
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Admin shared config: all authenticated users can READ, only admin WRITE
    match /admin/config {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin secrets (API keys): ADMIN ONLY.
    // 以前は「サインインした人なら誰でも読める」になっていた。ここには Anthropic /
    // OpenAI / Google の API キーの生の値が入っていて、しかもその鍵はほかの
    // プロダクトと共有している。登録できる人は誰でも読み出せる状態だったので閉じた。
    match /admin/secrets {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Other admin docs (prompts history, etc.)
    // 重要: Firestore の規則は「どれかが許せば許す」(OR) なので、この受け皿が
    // /admin/secrets にも当たる。secrets をここから必ず外しておかないと、
    // 上の admin 限定が効かない。
    match /admin/{docId} {
      allow read: if request.auth != null && docId != 'secrets';
      allow write: if isAdmin();
    }
  }
}
